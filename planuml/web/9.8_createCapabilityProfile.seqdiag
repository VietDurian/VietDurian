actor "Service Provider" as Users
boundary CapabilityProfileFormPage
control serviceProviderProfileController
participant ":serviceProviderProfileService" as Service
participant ":serviceProviderProfileModel" as Model
database Database

activate Users
Users->CapabilityProfileFormPage: 1. Input capability + service areas
activate CapabilityProfileFormPage
Users->CapabilityProfileFormPage: 2. Submit capability profile form
CapabilityProfileFormPage->CapabilityProfileFormPage: 3. Validate input
activate CapabilityProfileFormPage
space
deactivate CapabilityProfileFormPage
opt Validation error
    CapabilityProfileFormPage-->Users: 3.1 Display validation error
end

CapabilityProfileFormPage->serviceProviderProfileController: 4. Create capability profile
activate serviceProviderProfileController
serviceProviderProfileController->Service: 5. createCapabilityProfile(userId, payload)
activate Service

Service->Model: 6. findByUserId(userId)
activate Model
Model->Database: 7. findOne()
activate Database
Database-->Model: 8. Return profile document (or null)
deactivate Database
Model-->Service: 9. Return result
deactivate Model

Service->Service: 11. checkExistingProfile()
activate Service
space
deactivate Service
alt Profile already exists
    Service-->serviceProviderProfileController: 11.1 Return error: profile already exists
    serviceProviderProfileController-->CapabilityProfileFormPage: 11.1.1 Return error
    CapabilityProfileFormPage-->Users: 11.1.2 Display error: profile already exists
else Profile not exists
    Service->Service: 11.2. validateCapabilityData()
    activate Service
    space
    deactivate Service
    alt Create capability profile failed
        Service-->serviceProviderProfileController: 11.2.1 Return error: invalid data
        serviceProviderProfileController-->CapabilityProfileFormPage: 11.2.1.1 Return error
        CapabilityProfileFormPage-->Users: 11.2.1.2 Display validation error
    else Create capability profile successful
        Service->Model: 11.2.2. createProfile()
        activate Model
        Model->Database: 11.2.2.1 insertOne()
        activate Database
        Database-->Model: 11.2.2.2 Confirm inserted
        deactivate Database
        Model-->Service: 11.2.2.3 Return created profile
        deactivate Model
        Service->Service: 11.2.2.4 mapToCapabilityDTO()
        activate Service
        space
        deactivate Service
        Service-->serviceProviderProfileController: 11.2.2.5. Return success + capability data
        deactivate Service
        serviceProviderProfileController-->CapabilityProfileFormPage: 11.2.2.6 Return success + capability data
        deactivate serviceProviderProfileController

        CapabilityProfileFormPage-->Users: 11.2.2.7 Display success + service areas
        deactivate CapabilityProfileFormPage
        deactivate Users
    end
end