actor "Service Provider" as Users
boundary CapabilityProfileFormPage
control serviceProviderProfileController
participant ":serviceProviderProfileService" as Service
participant ":serviceProviderProfileModel" as Model
database Database

activate Users
Users->CapabilityProfileFormPage: 1. Open capability profile update form
activate CapabilityProfileFormPage
CapabilityProfileFormPage->serviceProviderProfileController: 2. Get capability profile data
activate serviceProviderProfileController
serviceProviderProfileController->Service: 3. getCapabilityProfile(userId)
activate Service
Service->Model: 4. findByUserId(userId)
activate Model
Model->Database: 5. findOne()
activate Database
Database-->Model: 6. Return existing capability profile
deactivate Database
Model-->Service: 7. Return profile document
deactivate Model
Service->Service: 8. mapToCapabilityDTO()
activate Service
space
deactivate Service
Service-->serviceProviderProfileController: 9. Return capability profile data
deactivate Service
serviceProviderProfileController-->CapabilityProfileFormPage: 10. Return capability profile data
deactivate serviceProviderProfileController
CapabilityProfileFormPage-->Users: 11. Display current capability + service areas

Users->CapabilityProfileFormPage: 12. Edit capability profile form
Users->CapabilityProfileFormPage: 13. Submit update capability profile form
CapabilityProfileFormPage->CapabilityProfileFormPage: 14. Validate input
activate CapabilityProfileFormPage
space
deactivate CapabilityProfileFormPage
opt Validation error
    CapabilityProfileFormPage-->Users: 14.1 Display validation error
end

CapabilityProfileFormPage->serviceProviderProfileController: 15. Update capability profile request
activate serviceProviderProfileController
serviceProviderProfileController->Service: 16. updateCapabilityProfile(userId, payload)
activate Service

Service->Model: 17. findByUserId(userId)
activate Model
Model->Database: 18. findOne()
activate Database
Database-->Model: 19. Return existing profile document (or null)
deactivate Database
Model-->Service: 20. Return result
deactivate Model

Service->Service: 21. checkExistingProfile()
activate Service
space
deactivate Service
alt Capability profile not exists
    Service-->serviceProviderProfileController: 21.1 Return error: profile not found
    serviceProviderProfileController-->CapabilityProfileFormPage: 21.1.1 Return error
    CapabilityProfileFormPage-->Users: 21.1.2 Display error: profile not found
else Capability profile exists
    Service->Service: 21.2. validateCapabilityData()
    activate Service
    space
    deactivate Service
    alt Update capability profile failed
        Service-->serviceProviderProfileController: 21.2.1 Return error: invalid data
        serviceProviderProfileController-->CapabilityProfileFormPage: 21.2.1.1 Return error
        CapabilityProfileFormPage-->Users: 21.2.1.2 Display validation error
    else Update capability profile successful
        Service->Model: 21.2.2. updateProfile(userId, payload)
        activate Model
        Model->Database: 21.2.2.1 findOneAndUpdate()
        activate Database
        Database-->Model: 21.2.2.2 Return updated profile
        deactivate Database
        Model-->Service: 21.2.2.3 Return updated profile
        deactivate Model
        Service->Service: 21.2.2.4 mapToCapabilityDTO()
        activate Service
        space
        deactivate Service
        Service-->serviceProviderProfileController: 21.2.2.5 Return success + updated capability data
        deactivate Service
        serviceProviderProfileController-->CapabilityProfileFormPage: 21.2.2.6 Return success + updated capability data
        deactivate serviceProviderProfileController
        CapabilityProfileFormPage-->Users: 21.2.2.7 Display success + updated service areas
        deactivate CapabilityProfileFormPage
        deactivate Users
    end
end