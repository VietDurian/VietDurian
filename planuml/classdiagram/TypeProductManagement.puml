@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 120
skinparam ranksep 110
top to bottom direction

package "TypeProductManagementModule" {

	' --- ROUTE & MIDDLEWARE ---
	class TypeProductRoute {
		+createTypeProduct(req, res): void
		+getAllTypeProducts(req, res): void
		+updateTypeProduct(req, res): void
		+deleteTypeProduct(req, res): void
		+searchTypeProducts(req, res): void
		+sortTypeProducts(req, res): void
	}

	class AuthMiddleware {
		+protect(req): UserInfo
	}

	class AuthorizationMiddleware {
		+isAdmin(req): void
	}

	' --- CONTROLLER ---
	class TypeProductController {
		-typeProductService: TypeProductService
		+createTypeProduct(req, res, next): Promise<void>
		+getAllTypeProducts(req, res, next): Promise<void>
		+updateTypeProduct(req, res, next): Promise<void>
		+deleteTypeProduct(req, res, next): Promise<void>
		+searchTypeProducts(req, res, next): Promise<void>
		+sortTypeProducts(req, res, next): Promise<void>
	}

	' --- SERVICE ---
	class TypeProductService {
		-typeProductModel: TypeProductModel
		+createTypeProduct(data): Promise<TypeProduct>
		+getAllTypeProducts(params): Promise<{ data: TypeProduct[], pagination }>
		+updateTypeProduct(typeProductId, data): Promise<TypeProduct>
		+deleteTypeProduct(typeProductId): Promise<TypeProduct>
		+searchTypeProducts(params): Promise<{ data: TypeProduct[], pagination }>
		+sortTypeProducts(params): Promise<{ data: TypeProduct[], pagination }>
	}

	' --- DATA ACCESS (MODEL) ---
	class TypeProductModel {
		+find(filter): TypeProduct[]
		+findById(id): TypeProduct | null
		+findByIdAndUpdate(id, update, options): TypeProduct
		+findByIdAndDelete(id): TypeProduct
		+countDocuments(filter): number
		+save(): TypeProduct
	}

	class Database {
	}

	' --- ENTITIES ---
	class TypeProduct {
		+_id: ObjectId
		+name: string
		+description: string
		+created_at: Date
		+updated_at: Date
	}

	class Product {
		+_id: ObjectId
		+type_id: ObjectId
		+name: string
	}
}

' --- RELATIONSHIPS ---

' === DEPENDENCY: Route -> Middleware & Controller ===
TypeProductRoute ..> AuthMiddleware : Dependency
TypeProductRoute ..> AuthorizationMiddleware : Dependency
TypeProductRoute ..> TypeProductController : Dependency

' === DEPENDENCY: Controller -> Service ===
TypeProductController ..> TypeProductService : Dependency

' === DEPENDENCY: Service -> Model ===
TypeProductService ..> TypeProductModel : Dependency

' === DEPENDENCY: Model -> Entity ===
TypeProductModel ..> TypeProduct : Dependency

' === ASSOCIATION: Entity relationships ===
TypeProduct "1" --> "many" Product

' === PERSISTENCE: Model -> Database ===
TypeProductModel --> Database : queries

@enduml