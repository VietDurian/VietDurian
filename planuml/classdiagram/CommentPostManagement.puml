@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 120
skinparam ranksep 110
top to bottom direction

package "CommentPostModule" {

	' --- ROUTE & MIDDLEWARE ---
	class CommentPostRoute {
		+createCommentPost(req, res): void
		+viewCommentPost(req, res): void
		+updateCommentPost(req, res): void
		+deleteCommentPost(req, res): void
		+replyCommentPost(req, res): void
		+filterCommentPost(req, res): void
	}

	class AuthMiddleware {
		+protect(req): UserInfo
	}

	' --- CONTROLLER ---
	class CommentPostController {
		-commentPostService: CommentPostService
		+createCommentPost(req, res, next): Promise<void>
		+viewCommentPost(req, res, next): Promise<void>
		+updateCommentPost(req, res, next): Promise<void>
		+deleteCommentPost(req, res, next): Promise<void>
		+replyCommentPost(req, res, next): Promise<void>
		+filterCommentPost(req, res, next): Promise<void>
	}

	' --- SERVICE ---
	class CommentPostService {
		-commentPostModel: CommentPostModel
		-generalPostModel: GeneralPostModel
		-userModel: UserModel
		+createCommentPost(data): Promise<CommentPost>
		+viewCommentPost(postId, params): Promise<{ data: CommentPost[], pagination }>
		+updateCommentPost(commentId, data): Promise<CommentPost>
		+deleteCommentPost(commentId): Promise<CommentPost>
		+replyCommentPost(parentId, data): Promise<CommentPost>
		+filterCommentPost(params): Promise<{ data: CommentPost[], pagination }>
	}

	' --- DATA ACCESS (MODELS) ---
	class CommentPostModel {
		+find(filter): CommentPost[]
		+findById(id): CommentPost | null
		+findByIdAndUpdate(id, update, options): CommentPost
		+findByIdAndDelete(id): CommentPost
		+countDocuments(filter): number
		+save(): CommentPost
	}

	class GeneralPostModel {
		+findById(id): GeneralPost | null
	}

	class UserModel {
		+findById(id): User | null
	}

	class Database {
	}

	' --- ENTITIES ---
	class CommentPost {
		+_id: ObjectId
		+post_id: ObjectId
		+author_id: ObjectId
		+parent_id: ObjectId
		+content: string
		+is_active: string
		+created_at: Date
		+updated_at: Date
	}

	class GeneralPost {
		+_id: ObjectId
		+title: string
		+content: string
	}

	class User {
		+_id: ObjectId
		+full_name: string
		+avatar: string
	}
}

' --- RELATIONSHIPS ---

' === DEPENDENCY: Route -> Middleware & Controller ===
CommentPostRoute ..> AuthMiddleware : Dependency
CommentPostRoute ..> CommentPostController : Dependency

' === DEPENDENCY: Controller -> Service ===
CommentPostController ..> CommentPostService : Dependency

' === DEPENDENCY: Service -> Models ===
CommentPostService ..> CommentPostModel : Dependency
CommentPostService ..> GeneralPostModel : Dependency
CommentPostService ..> UserModel : Dependency

' === DEPENDENCY: Model -> Entity ===
CommentPostModel ..> CommentPost : Dependency
GeneralPostModel ..> GeneralPost : Dependency
UserModel ..> User : Dependency

' === ASSOCIATION: Entity relationships ===
GeneralPost "1" --> "many" CommentPost
User "1" --> "many" CommentPost
CommentPost "many" --> "0..1" CommentPost

' === PERSISTENCE: Models -> Database ===
CommentPostModel --> Database : queries
GeneralPostModel --> Database : queries
UserModel --> Database : queries

@enduml