@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 120
skinparam ranksep 110
top to bottom direction

package "UserManagementModule" {

	' --- ROUTE & MIDDLEWARE ---
	class UserRoute {
		+getAllUsers(req, res): void
		+getUserById(req, res): void
		+toggleBan(req, res): void
		+searchUser(req, res): void
		+filterUsers(req, res): void
		+sortUsers(req, res): void
	}

	class AuthMiddleware {
		+protect(req): UserInfo
	}

	class AuthorizationMiddleware {
		+isAdmin(req): void
	}

	' --- CONTROLLER ---
	class UserController {
		-userService: UserService
		+getAllUsers(req, res, next): Promise<void>
		+getUserById(req, res, next): Promise<void>
		+toggleBan(req, res, next): Promise<void>
		+searchUser(req, res, next): Promise<void>
		+filterUsers(req, res, next): Promise<void>
		+sortUsers(req, res, next): Promise<void>
	}

	' --- SERVICE ---
	class UserService {
		-userModel: UserModel
		+getAllUsers(page, limit): Promise<PaginatedUsers>
		+getUserById(id): Promise<User>
		+banUser(id, is_banned): Promise<User>
		+searchUsers(keyword): Promise<User[]>
		+filterUsers(filters): Promise<User[]>
		+sortUsers(sort): Promise<User[]>
	}

	' --- DTO ---
	class PaginatedUsers {
		+users: User[]
		+total: number
		+page: number
		+totalPages: number
	}

	' --- DATA ACCESS (MODEL) ---
	class UserModel {
		+find(query): User[]
		+findById(id): User | null
		+findByIdAndUpdate(id, update, options): User
		+countDocuments(filter): number
	}

	class Database {
	}

	' --- ENTITY ---
	class User {
		+_id: ObjectId
		+full_name: string
		+email: string
		+password: string
		+phone: string
		+avatar: string
		+role: string
		+is_banned: boolean
		+is_verified: boolean
		+created_at: Date
		+updated_at: Date
	}
}

' --- RELATIONSHIPS ---

' === DEPENDENCY: Route -> Middleware & Controller ===
UserRoute ..> AuthMiddleware : Dependency
UserRoute ..> AuthorizationMiddleware : Dependency
UserRoute ..> UserController : Dependency

' === DEPENDENCY: Controller -> Service ===
UserController ..> UserService : Dependency

' === DEPENDENCY: Service -> Model ===
UserService ..> UserModel : Dependency

' === DEPENDENCY: Service -> DTO ===
UserService ..> PaginatedUsers : Dependency

' === DEPENDENCY: Model -> Entity ===
UserModel ..> User : Dependency

' === PERSISTENCE: Model -> Database ===
UserModel --> Database : queries

@enduml