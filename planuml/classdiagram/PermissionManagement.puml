@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 120
skinparam ranksep 110
top to bottom direction

package "PermissionManagementModule" {

	' --- ROUTE & MIDDLEWARE ---
	class PermissionRoute {
		+getPermissionRequests(req, res): void
		+searchPermissionRequests(req, res): void
		+sortPermissionRequests(req, res): void
		+getPermissionRequestDetail(req, res): void
		+confirmAccount(req, res): void
		+rejectAccount(req, res): void
	}

	class AuthMiddleware {
		+protect(req): UserInfo
	}

	class AuthorizationMiddleware {
		+isAdmin(req): void
	}

	' --- CONTROLLER ---
	class PermissionController {
		-permissionService: PermissionService
		+getPermissionRequests(req, res, next): Promise<void>
		+getPermissionRequestDetail(req, res, next): Promise<void>
		+searchPermissionRequests(req, res, next): Promise<void>
		+sortPermissionRequests(req, res, next): Promise<void>
		+confirmAccount(req, res, next): Promise<void>
		+rejectAccount(req, res, next): Promise<void>
	}

	' --- SERVICE ---
	class PermissionService {
		-permissionAccountModel: PermissionAccountModel
		-userModel: UserModel
		-emailService: EmailService
		+getPermissionRequests(): Promise<PermissionAccount[]>
		+getPermissionRequestDetail(request_id): Promise<PermissionAccount>
		+searchPermissionRequests(params): Promise<PermissionAccount[]>
		+sortPermissionRequests(params): Promise<PermissionAccount[]>
		+confirmPermissionRequest(request_id, adminId): Promise<PermissionAccount>
		+rejectPermissionRequest(request_id, adminId, reason): Promise<PermissionAccount>
	}

	' --- EXTERNAL SERVICE ---
	class EmailService {
		+sendPermissionStatusEmail(payload): Promise<boolean>
	}

	' --- DATA ACCESS (MODELS) ---
	class PermissionAccountModel {
		+aggregate(pipeline): PermissionAccount[]
		+findById(id): PermissionAccount | null
		+save(): void
	}

	class UserModel {
		+findById(id): User | null
		+save(): void
	}

	class Database {
	}

	' --- ENTITIES ---
	class PermissionAccount {
		+_id: ObjectId
		+user_id: ObjectId
		+requested_role: string
		+description: string
		+document: string
		+status: string
		+created_at: Date
		+updated_at: Date
	}

	class User {
		+_id: ObjectId
		+full_name: string
		+email: string
		+avatar: string
		+role: string
		+is_verified: boolean
		+is_banned: boolean
		+created_at: Date
		+updated_at: Date
	}
}

' --- RELATIONSHIPS ---

' === DEPENDENCY: Route -> Middleware & Controller ===
PermissionRoute ..> AuthMiddleware : Dependency
PermissionRoute ..> AuthorizationMiddleware : Dependency
PermissionRoute ..> PermissionController : Dependency

' === DEPENDENCY: Controller -> Service ===
PermissionController ..> PermissionService : Dependency

' === DEPENDENCY: Service -> Models & External ===
PermissionService ..> PermissionAccountModel : Dependency
PermissionService ..> UserModel : Dependency
PermissionService ..> EmailService : Dependency

' === DEPENDENCY: Model -> Entity ===
PermissionAccountModel ..> PermissionAccount : Dependency
UserModel ..> User : Dependency

' === ASSOCIATION: Entity relationships ===
User "1" --> "many" PermissionAccount

' === PERSISTENCE: Models -> Database ===
PermissionAccountModel --> Database : queries
UserModel --> Database : queries

@enduml