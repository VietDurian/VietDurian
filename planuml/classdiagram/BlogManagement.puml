@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 120
skinparam ranksep 110
top to bottom direction

package "BlogModule" {

	' --- ROUTE & MIDDLEWARE ---
	class BlogRoute {
		+getKnowledgeBlogs(req, res): void
		+getKnowledgeBlogDetails(req, res): void
		+getKnowledgeBlocksByBlogId(req, res): void
		+createKnowledgeBlog(req, res): void
		+createKnowledgeBlock(req, res): void
		+updateKnowledgeBlog(req, res): void
		+updateKnowledgeBlock(req, res): void
		+deleteKnowledgeBlog(req, res): void
		+deleteKnowledgeBlock(req, res): void
	}

	class AuthMiddleware {
		+protect(req): UserInfo
	}

	' --- CONTROLLER ---
	class BlogController {
		-blogService: BlogService
		+getKnowledgeBlogs(req, res, next): Promise<void>
		+getKnowledgeBlogDetails(req, res, next): Promise<void>
		+getKnowledgeBlocksByBlogId(req, res, next): Promise<void>
		+createKnowledgeBlog(req, res, next): Promise<void>
		+createKnowledgeBlock(req, res, next): Promise<void>
		+updateKnowledgeBlog(req, res, next): Promise<void>
		+updateKnowledgeBlock(req, res, next): Promise<void>
		+deleteKnowledgeBlog(req, res, next): Promise<void>
		+deleteKnowledgeBlock(req, res, next): Promise<void>
	}

	' --- SERVICE ---
	class BlogService {
		-knowledgeBlogModel: KnowledgeBlogModel
		-knowledgeBlockModel: KnowledgeBlockModel
		+createKnowledgeBlog(data): Promise<KnowledgeBlog>
		+getKnowledgeBlogs(params): Promise<KnowledgeBlog[]>
		+getKnowledgeBlogDetails(blogId): Promise<KnowledgeBlog | null>
		+updateKnowledgeBlog(blogId, data): Promise<KnowledgeBlog>
		+deleteKnowledgeBlog(blogId): Promise<void>
		+createKnowledgeBlock(data): Promise<KnowledgeBlock>
		+getKnowledgeBlocksByBlogId(blogId): Promise<KnowledgeBlock[]>
		+updateKnowledgeBlock(blockId, data): Promise<KnowledgeBlock>
		+deleteKnowledgeBlock(blockId): Promise<void>
	}

	' --- DATA ACCESS (MODELS) ---
	class KnowledgeBlogModel {
		+find(filter): KnowledgeBlog[]
		+findById(id): KnowledgeBlog | null
		+findByIdAndUpdate(id, update, options): KnowledgeBlog
		+findByIdAndDelete(id): KnowledgeBlog
		+countDocuments(filter): number
		+save(): KnowledgeBlog
	}

	class KnowledgeBlockModel {
		+find(filter): KnowledgeBlock[]
		+findById(id): KnowledgeBlock | null
		+findByIdAndUpdate(id, update, options): KnowledgeBlock
		+findByIdAndDelete(id): KnowledgeBlock
		+deleteMany(filter): number
		+save(): KnowledgeBlock
	}

	class CloudinaryService {
		+upload(image, options): UploadResult
	}

	class Database {
	}

	' --- ENTITIES ---
	class KnowledgeBlog {
		+_id: ObjectId
		+title: string
		+content: string
		+author_id: ObjectId
		+image: string
		+status: string
		+created_at: Date
		+updated_at: Date
	}

	class KnowledgeBlock {
		+_id: ObjectId
		+blog_id: ObjectId
		+title: string
		+content: string
		+image: string
		+created_at: Date
		+updated_at: Date
	}

	class User {
		+_id: ObjectId
		+full_name: string
		+avatar: string
	}
}

' --- RELATIONSHIPS ---

' === DEPENDENCY: Route -> Middleware & Controller ===
BlogRoute ..> AuthMiddleware : Dependency
BlogRoute ..> BlogController : Dependency

' === DEPENDENCY: Controller -> Service ===
BlogController ..> BlogService : Dependency

' === DEPENDENCY: Service -> Models ===
BlogService ..> KnowledgeBlogModel : Dependency
BlogService ..> KnowledgeBlockModel : Dependency
BlogService ..> CloudinaryService : Dependency

' === DEPENDENCY: Model -> Entity ===
KnowledgeBlogModel ..> KnowledgeBlog : Dependency
KnowledgeBlogModel ..> User : ref(author_id)
KnowledgeBlockModel ..> KnowledgeBlock : Dependency

' === ASSOCIATION: Entity relationships ===
User "1" --> "many" KnowledgeBlog
KnowledgeBlog "1" --> "many" KnowledgeBlock

' === PERSISTENCE: Models -> Database ===
KnowledgeBlogModel --> Database : queries
KnowledgeBlockModel --> Database : queries

@enduml