@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 120
skinparam ranksep 110
top to bottom direction

package "BlockModule" {

	' --- ROUTE & MIDDLEWARE ---
	class BlockRoute {
		+createBlock(req, res): void
		+viewBlock(req, res): void
		+updateBlock(req, res): void
		+deleteBlock(req, res): void
	}

	class AuthMiddleware {
		+protect(req): UserInfo
	}

	' --- CONTROLLER ---
	class BlockController {
		-blockService: BlockService
		+createBlock(req, res, next): Promise<void>
		+viewBlock(req, res, next): Promise<void>
		+updateBlock(req, res, next): Promise<void>
		+deleteBlock(req, res, next): Promise<void>
	}

	' --- SERVICE ---
	class BlockService {
		-blockModel: BlockModel
		-blogModel: BlogModel
		+createBlock(data): Promise<Block>
		+viewBlock(blogId): Promise<Block[]>
		+updateBlock(blockId, data): Promise<Block>
		+deleteBlock(blockId): Promise<Block>
	}

	' --- DATA ACCESS (MODELS) ---
	class BlockModel {
		+find(filter): Block[]
		+findById(id): Block | null
		+findByIdAndUpdate(id, update, options): Block
		+findByIdAndDelete(id): Block
		+countDocuments(filter): number
		+save(): Block
	}

	class BlogModel {
		+findById(id): Blog | null
	}

	class Database {
	}

	' --- ENTITIES ---
	class Block {
		+_id: ObjectId
		+blog_id: ObjectId
		+title: string
		+content: string
		+image: string
		+created_at: Date
		+updated_at: Date
	}

	class Blog {
		+_id: ObjectId
		+title: string
		+content: string
	}
}

' --- RELATIONSHIPS ---

' === DEPENDENCY: Route -> Middleware & Controller ===
BlockRoute ..> AuthMiddleware : Dependency
BlockRoute ..> BlockController : Dependency

' === DEPENDENCY: Controller -> Service ===
BlockController ..> BlockService : Dependency

' === DEPENDENCY: Service -> Models ===
BlockService ..> BlockModel : Dependency
BlockService ..> BlogModel : Dependency

' === DEPENDENCY: Model -> Entity ===
BlockModel ..> Block : Dependency
BlogModel ..> Blog : Dependency

' === ASSOCIATION: Entity relationships ===
Blog "1" --> "many" Block

' === PERSISTENCE: Models -> Database ===
BlockModel --> Database : queries
BlogModel --> Database : queries

@enduml